{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": ["vite/client", "node"]
  },
  "include": ["frontend/**/*.ts", "frontend/**/*.tsx", "vitest.config.ts"]
}
