# Development only. Copy to .env; never commit real credentials.
POSTGRES_USER=auction
POSTGRES_PASSWORD=auction_dev
POSTGRES_DB=auction_house
POSTGRES_PORT=5433
API_PORT=8000
DATABASE_URL=postgresql+psycopg://auction:auction_dev@localhost:5433/auction_house
# Neon: use the pooled connection above, direct connection below; keep sslmode=require.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=require

# Generate privately with npm run setup:env. Never use a shared/default JWT secret.
AUTH_SECRET=
# Separate signing key for accepted bids. Preserve it with your backups.
AUDIT_SECRET=
ACCESS_TOKEN_MINUTES=30
# Single-process API publisher. Disable only for maintenance/tests.
EVENTS_ENABLED=true

# Docker frontend; local Vite runs separately at 5173.
FRONTEND_PORT=5174
VITE_USE_MOCK=false

# Separate frontend/API domains. JSON list; no trailing slash in origins.
CORS_ORIGINS=[]
# Production frontend example: https://your-api.onrender.com (without /api).
VITE_API_URL=/api
# Only true when the API and closing worker run together (Render entrypoint).
WORKER_REQUIRED=false
